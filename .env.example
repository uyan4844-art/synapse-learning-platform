# ==============================================================================
# SYNAPSE AI (StudyAI) - Environment Variables Configuration (.env.example)
# ==============================================================================
# Bu dosya, uygulamanın tüm yapay zeka, kimlik doğrulama, çok oyunculu lobi
# ve ödeme altyapısının yerel ve canlı ortamda çalışması için gereken
# çevre değişkenlerinin (environment variables) şablonudur.
#
# Kurulum için: Bu dosyayı kopyalayarak '.env.local' adında kaydedin ve
# ilgili anahtarları doldurun.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (NOVA Soru Motoru & Pedagojik Teşhis)
# ------------------------------------------------------------------------------
# Platformda soru üretimi, altyazı analizi ve kavram yanılgısı tespiti için
# Gemini 2.5 Flash / 3.5 Flash / 3.7 Flash modelleri kullanılır.
# Google AI Studio (https://aistudio.google.com/app/apikey) üzerinden temin edilir.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH & REALTIME DATABASE (Kullanıcı, Lobi & Veritabanı)
# ------------------------------------------------------------------------------
# Kullanıcı oturum açma, ELO puanları, profil tercihleri ve Çok Oyunculu
# Canlı Lobi (Supabase Realtime / WebSocket) senkronizasyonu için gereklidir.
# Supabase Dashboard (Project Settings -> API) üzerinden temin edilir.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENTS & SUBSCRIPTIONS (Pro / Group Üyelik & Webhook)
# ------------------------------------------------------------------------------
# Bölgesel fiyatlandırma ve Pro abonelik satın alımları için Stripe API anahtarları.
# Stripe Dashboard (https://dashboard.stripe.com/apikeys) üzerinden temin edilir.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_signing_key

# ------------------------------------------------------------------------------
# 4. YOUTUBE TRANSCRIPT & MODALITIES (Opsiyonel Harici Servisler)
# ------------------------------------------------------------------------------
# YouTube transkriptleri varsayılan olarak dahili 'youtube-transcript-io'
# kütüphanesiyle otomatik çekilir. İleri düzey kota ve yedekleme için:
# YOUTUBE_API_KEY=your_youtube_data_api_key

# ------------------------------------------------------------------------------
# 5. UYGULAMA GENEL AYARLARI
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
